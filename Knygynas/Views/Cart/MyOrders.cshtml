@model IEnumerable<Knygynas.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="background-color: #d1e7dd; border-left: 5px solid #0f5132;">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                <div>
                    <h5 class="alert-heading mb-1 font-weight-bold">Order Placed Successfully!</h5>
                    <p class="mb-0">@TempData["SuccessMessage"]</p>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-weight-bold text-dark mb-1">My Orders & Live Tracking</h2>
            <p class="text-muted mb-0">Track all your order packages, deliveries, and status updates live.</p>
        </div>
        <span class="badge bg-primary fs-6 p-2">Orders Count: @Model.Count()</span>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <div class="display-1 text-muted mb-4">
                    <i class="bi bi-box-seam"></i>
                </div>
                <h4 class="font-weight-bold text-dark mb-2">No Orders Found</h4>
                <p class="text-muted mb-4" style="max-width: 500px; margin: auto;">You haven't placed any bookstore orders yet. Explore our awesome collection of books and start filling your library!</p>
                <a asp-controller="Book" asp-action="List" class="btn btn-primary btn-lg px-5">Explore Books</a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="px-4 py-3">Order ID</th>
                                <th class="py-3">Order Date</th>
                                <th class="py-3">Delivery Option</th>
                                <th class="py-3 text-end">Total Price</th>
                                <th class="py-3 text-center">Status</th>
                                <th class="px-4 py-3 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td class="px-4 font-weight-bold">#@order.Id</td>
                                    <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (order.DeliveryMethod == "Postomat")
                                            {
                                                
                                                <span>Postomat Locker</span>
                                            }
                                            else if (order.DeliveryMethod == "Bookstore")
                                            {
                                                
                                                <span>Bookstore Pickup</span>
                                            }
                                            else
                                            {
                                                
                                                <span>Home Delivery</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end font-weight-bold text-primary">$@order.TotalPrice.ToString("F2")</td>
                                    <td class="text-center">
                                        @switch (order.State)
                                        {
                                            case Knygynas.Models.OrderState.PendingPayment:
                                                <span class="badge bg-secondary px-3 py-2 fs-7">Pending Payment</span>
                                                break;
                                            case Knygynas.Models.OrderState.Processing:
                                                <span class="badge bg-warning text-dark px-3 py-2 fs-7">Processing</span>
                                                break;
                                            case Knygynas.Models.OrderState.Prepared:
                                                <span class="badge bg-info text-dark px-3 py-2 fs-7">Prepared</span>
                                                break;
                                            case Knygynas.Models.OrderState.Shipped:
                                                <span class="badge bg-primary px-3 py-2 fs-7">Shipped</span>
                                                break;
                                            case Knygynas.Models.OrderState.Finished:
                                                <span class="badge bg-success px-3 py-2 fs-7">Finished</span>
                                                break;
                                            case Knygynas.Models.OrderState.Returning:
                                                <span class="badge bg-warning text-dark px-3 py-2 fs-7">Returning</span>
                                                break;
                                            case Knygynas.Models.OrderState.Returned:
                                                <span class="badge bg-dark px-3 py-2 fs-7">Returned</span>
                                                break;
                                            case Knygynas.Models.OrderState.Cancelled:
                                                <span class="badge bg-danger px-3 py-2 fs-7">Cancelled</span>
                                                break;
                                        }
                                    </td>
                                    <td class="px-4 text-end">
                                        <a asp-action="OrderSuccess" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm px-4">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
