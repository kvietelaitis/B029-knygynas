@model Knygynas.Models.Order
@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <div class="display-1 text-success mb-3">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h1 class="font-weight-bold text-dark">Thank You for Your Order!</h1>
        <p class="lead text-muted">Your order has been placed successfully and is currently being processed.</p>
        <span class="badge bg-primary fs-6 p-2">Order ID: #@Model.Id</span>
    </div>

    <div class="row">
        <!-- Order Route & Transit details -->
        <div class="col-md-7 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white p-3">
                    <h5 class="mb-0 font-weight-bold"><i class="bi bi-truck me-2"></i>Delivery Information</h5>
                </div>
                <div class="card-body p-4">
                    <!-- Shipping Route Visualization -->
                    <div class="shipping-route mb-5 position-relative px-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <!-- Origin Node -->
                            <div class="text-center z-3 bg-white p-2">
                                <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px;">
                                    <i class="bi bi-building fs-4"></i>
                                </div>
                                <h6 class="font-weight-bold mb-0">@Model.FromCity</h6>
                                <small class="text-muted">Dispatch Bookstore</small>
                            </div>
                            
                            <!-- Connecting Line -->
                            <div class="flex-grow-1 border-top border-2 border-dashed border-primary mx-3 position-relative" style="height: 1px; top: -15px;">
                                <div class="position-absolute start-50 translate-middle-y bg-primary text-white px-2 py-1 rounded-pill" style="font-size: 0.7rem; top: -1px;">
                                    Transit
                                </div>
                            </div>
                            
                            <!-- Destination Node -->
                            <div class="text-center z-3 bg-white p-2">
                                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px;">
                                    @if (Model.DeliveryMethod == "Postomat")
                                    {
                                        <i class="bi bi-box-seam fs-4"></i>
                                    }
                                    else if (Model.DeliveryMethod == "Bookstore")
                                    {
                                        <i class="bi bi-shop fs-4"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-house-door fs-4"></i>
                                    }
                                </div>
                                <h6 class="font-weight-bold mb-0">@Model.ToCity</h6>
                                <small class="text-muted">@Model.DeliveryMethod Delivery</small>
                            </div>
                        </div>
                    </div>

                    <!-- Details Table -->
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <th scope="row" class="text-muted px-0">Ship From Address</th>
                                <td class="text-end font-weight-bold">@Model.FromCity, @Model.FromAddress</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted px-0">Delivery Address</th>
                                <td class="text-end font-weight-bold text-success">@Model.ToCity, @Model.ToAddress</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted px-0">Delivery Method</th>
                                <td class="text-end font-weight-bold">@Model.DeliveryMethod</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted px-0">Contact Phone</th>
                                <td class="text-end font-weight-bold">@Model.PhoneNumber</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted px-0">Order Date</th>
                                <td class="text-end font-weight-bold">@Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted px-0">Current State</th>
                                <td class="text-end">
                                    <span class="badge bg-warning text-dark px-3 py-2">@Model.State.ToString()</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Ordered Items Summary -->
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white p-3">
                    <h5 class="mb-0 font-weight-bold"><i class="bi bi-receipt me-2"></i>Ordered Items</h5>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <ul class="list-group list-group-flush mb-4">
                        @foreach (var item in Model.OrderItems)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-3">
                                <div>
                                    <h6 class="font-weight-bold my-0">@(item.Book?.Title ?? item.BookISBN)</h6>
                                    <small class="text-muted">ISBN: @item.BookISBN</small>
                                    <div class="small text-muted">@item.Quantity × $@item.Price.ToString("F2")</div>
                                </div>
                                <span class="font-weight-bold text-dark">$@((item.Price * item.Quantity).ToString("F2"))</span>
                            </li>
                        }
                    </ul>
                    
                    <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                        <span class="fs-5 font-weight-bold">Total Paid</span>
                        <span class="fs-4 font-weight-bold text-primary">$@Model.TotalPrice.ToString("F2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <a asp-controller="Book" asp-action="List" class="btn btn-primary btn-lg px-5 mx-2">Continue Shopping</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg px-5 mx-2">Back to Home</a>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
