@model Knygynas.Models.Cart
@{
    ViewData["Title"] = "Checkout";
    var postomats = ViewBag.Postomats as List<Knygynas.Models.Postomat> ?? new List<Knygynas.Models.Postomat>();
    var bookstores = ViewBag.Bookstores as List<Knygynas.Models.Bookstore> ?? new List<Knygynas.Models.Bookstore>();
}

<div class="container mt-4">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Delivery Options & Form -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0 font-weight-bold">Select Delivery Option</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Checkout" method="post" id="checkoutForm">
                        <!-- Phone Number Input Field -->
                        <div class="card bg-light border-0 mb-4">
                            <div class="card-body">
                                <h5 class="card-title text-muted mb-3"><i class="bi bi-telephone me-2"></i>Contact Information</h5>
                                <div class="mb-0">
                                    <label for="phoneNumber" class="form-label font-weight-bold">Phone Number (for delivery notifications)</label>
                                    <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber" placeholder="e.g. +37060000000" required />
                                    <small class="text-muted">We will send delivery progress updates here.</small>
                                </div>
                            </div>
                        </div>

                        <!-- Custom Select Tabs -->
                        <div class="d-flex justify-content-around mb-4">
                            <button type="button" class="btn btn-outline-primary px-4 py-3 flex-fill mx-1 delivery-tab active" data-method="Postomat">
                                <i class="bi bi-box-seam fs-3 d-block mb-1"></i>
                                Postomat Locker
                            </button>
                            <button type="button" class="btn btn-outline-primary px-4 py-3 flex-fill mx-1 delivery-tab" data-method="Bookstore">
                                <i class="bi bi-shop fs-3 d-block mb-1"></i>
                                Bookstore Pickup
                            </button>
                            <button type="button" class="btn btn-outline-primary px-4 py-3 flex-fill mx-1 delivery-tab" data-method="Address">
                                <i class="bi bi-truck fs-3 d-block mb-1"></i>
                                Home Delivery
                            </button>
                        </div>

                        <!-- Hidden delivery method field -->
                        <input type="hidden" name="deliveryMethod" id="deliveryMethod" value="Postomat" />

                        <!-- Section: Postomat -->
                        <div id="section-Postomat" class="delivery-section">
                            <h5 class="mb-3 text-muted">Choose your closest Postomat locker:</h5>
                            <div class="mb-3">
                                <label for="selectedPostomatId" class="form-label font-weight-bold">Locker Location</label>
                                <select class="form-select" id="selectedPostomatId" name="selectedPostomatId">
                                    <option value="" disabled selected>-- Select a Locker --</option>
                                    @foreach (var postomat in postomats.OrderBy(p => p.City))
                                    {
                                        <option value="@postomat.Id">[@postomat.Company] @postomat.City, @postomat.Address</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Section: Bookstore -->
                        <div id="section-Bookstore" class="delivery-section d-none">
                            <h5 class="mb-3 text-muted">Select a bookstore for free pickup:</h5>
                            <div class="mb-3">
                                <label for="selectedBookstoreId" class="form-label font-weight-bold">Bookstore Location</label>
                                <select class="form-select" id="selectedBookstoreId" name="selectedBookstoreId">
                                    <option value="" disabled selected>-- Select a Bookstore --</option>
                                    @foreach (var bookstore in bookstores.OrderBy(b => b.City))
                                    {
                                        <option value="@bookstore.Id">@bookstore.City - @bookstore.Address</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Section: Address -->
                        <div id="section-Address" class="delivery-section d-none">
                            <h5 class="mb-3 text-muted">Enter your shipping address:</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="customCity" class="form-label font-weight-bold">City</label>
                                    <input type="text" class="form-control" id="customCity" name="customCity" placeholder="e.g. Vilnius" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="customAddress" class="form-label font-weight-bold">Address</label>
                                    <input type="text" class="form-control" id="customAddress" name="customAddress" placeholder="e.g. Gedimino pr. 1-1" />
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Back to Cart</a>
                            <button type="submit" class="btn btn-success btn-lg px-5">Confirm & Buy</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Order Summary Card -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-header bg-dark text-white p-3">
                    <h5 class="mb-0 font-weight-bold">Order Summary</h5>
                </div>
                <div class="card-body p-3">
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var item in Model.Items)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-3">
                                <div>
                                    <h6 class="my-0 font-weight-bold text-truncate" style="max-width: 180px;">@item.Title</h6>
                                    <small class="text-muted">Qty: @item.Quantity × $@item.Price.ToString("F2")</small>
                                </div>
                                <span class="text-muted font-weight-bold">$@item.Total.ToString("F2")</span>
                            </li>
                        }
                        <li class="list-group-item d-flex justify-content-between bg-transparent px-0 py-3">
                            <span class="fs-5 font-weight-bold">Total (USD)</span>
                            <strong class="fs-5 text-primary">$@Model.TotalPrice.ToString("F2")</strong>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Delivery Tab Switcher
            $(".delivery-tab").click(function () {
                var method = $(this).data("method");
                
                // Toggle active class on buttons
                $(".delivery-tab").removeClass("active");
                $(this).addClass("active");
                
                // Set hidden input value
                $("#deliveryMethod").val(method);
                
                // Show corresponding section and hide others
                $(".delivery-section").addClass("d-none");
                $("#section-" + method).removeClass("d-none");
            });

            // Form validation
            $("#checkoutForm").submit(function (e) {
                var phone = $("#phoneNumber").val().trim();
                if (!phone) {
                    alert("Please provide your phone number.");
                    e.preventDefault();
                    return false;
                }

                var method = $("#deliveryMethod").val();
                if (method === "Postomat") {
                    if (!$("#selectedPostomatId").val()) {
                        alert("Please select a postomat locker locker location.");
                        e.preventDefault();
                        return false;
                    }
                } else if (method === "Bookstore") {
                    if (!$("#selectedBookstoreId").val()) {
                        alert("Please select a bookstore pickup location.");
                        e.preventDefault();
                        return false;
                    }
                } else if (method === "Address") {
                    if (!$("#customCity").val().trim() || !$("#customAddress").val().trim()) {
                        alert("Please enter both City and Address for delivery.");
                        e.preventDefault();
                        return false;
                    }
                }
            });
        });
    </script>
}

<!-- Include Bootstrap Icons for the tabs if layout doesn't have it -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
