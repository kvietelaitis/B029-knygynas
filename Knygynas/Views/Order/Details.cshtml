@model Knygynas.Models.Order
@{
    ViewData["Title"] = $"Manage Order #{Model.Id}";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2"><i class="bi bi-arrow-left"></i> Back to Queue</a>
            <h2 class="mb-0 font-weight-bold">Order Details: #@Model.Id</h2>
            <small class="text-muted">Placed on @Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</small>
        </div>
        <div>
            <span class="badge bg-dark p-2 fs-6">Status: @Model.State.ToString()</span>
        </div>
    </div>

    <div class="row">
        <!-- Main details -->
        <div class="col-md-8 mb-4">
            <!-- Route details -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white p-3">
                    <h5 class="mb-0 font-weight-bold"><i class="bi bi-geo-alt me-2"></i>Shipping Route & Location</h5>
                </div>
                <div class="card-body p-4">
                    <!-- Route Indicator -->
                    <div class="d-flex justify-content-between align-items-center px-4 py-2 mb-4">
                        <div class="text-center">
                            <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px;">
                                <i class="bi bi-building fs-4"></i>
                            </div>
                            <h6 class="font-weight-bold mb-0">@Model.FromCity</h6>
                            <small class="text-muted">Source Depot</small>
                        </div>
                        
                        <div class="flex-grow-1 border-top border-2 border-dashed border-primary mx-3 position-relative" style="height: 1px; top: -15px;">
                            <div class="position-absolute start-50 translate-middle-y bg-primary text-white px-2 py-1 rounded-pill" style="font-size: 0.7rem; top: -1px;">
                                Courier Delivery
                            </div>
                        </div>
                        
                        <div class="text-center">
                            <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px;">
                                @if (Model.DeliveryMethod == "Postomat")
                                {
                                    <i class="bi bi-box-seam fs-4"></i>
                                }
                                else if (Model.DeliveryMethod == "Bookstore")
                                {
                                    <i class="bi bi-shop fs-4"></i>
                                }
                                else
                                {
                                    <i class="bi bi-house-door fs-4"></i>
                                }
                            </div>
                            <h6 class="font-weight-bold mb-0">@Model.ToCity</h6>
                            <small class="text-muted">@Model.DeliveryMethod Delivery</small>
                        </div>
                    </div>

                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <th scope="row" class="text-muted px-0" style="width: 30%;">Dispatch Address</th>
                                <td class="font-weight-bold">@Model.FromCity, @Model.FromAddress</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted px-0">Destination Address</th>
                                <td class="font-weight-bold text-success">@Model.ToCity, @Model.ToAddress</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted px-0">Way of Delivering</th>
                                <td class="font-weight-bold">@Model.DeliveryMethod</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted px-0">Customer email</th>
                                <td class="font-weight-bold">@(string.IsNullOrEmpty(Model.UserId) ? "Guest / Anonymous" : Model.UserId)</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted px-0">Customer phone</th>
                                <td class="font-weight-bold">@Model.PhoneNumber</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Ordered items -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white p-3">
                    <h5 class="mb-0 font-weight-bold"><i class="bi bi-receipt me-2"></i>Ordered Items</h5>
                </div>
                <div class="card-body p-4">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Book Title</th>
                                <th>ISBN</th>
                                <th class="text-end">Price</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>
                                        <div class="font-weight-bold">@(item.Book?.Title ?? item.BookISBN)</div>
                                    </td>
                                    <td><code>@item.BookISBN</code></td>
                                    <td class="text-end">$@item.Price.ToString("F2")</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end font-weight-bold text-primary">$@((item.Price * item.Quantity).ToString("F2"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end font-weight-bold fs-5">Total Order Value:</td>
                                <td class="text-end font-weight-bold text-primary fs-5">$@Model.TotalPrice.ToString("F2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Management Panel -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-header bg-warning text-dark p-3">
                    <h5 class="mb-0 font-weight-bold"><i class="bi bi-gear-fill me-2"></i>Update Order State</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <label for="state" class="form-label font-weight-bold">State Options:</label>
                            <select class="form-select form-select-lg" name="state" id="state" asp-for="State">
                                <option value="PendingPayment">Pending Payment</option>
                                <option value="Processing">Processing</option>
                                <option value="Prepared">Prepared</option>
                                <option value="Shipped">Shipped</option>
                                <option value="Finished">Finished</option>
                                <option value="Returning">Returning</option>
                                <option value="Returned">Returned</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-warning btn-lg w-100 font-weight-bold">Save Status Change</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
