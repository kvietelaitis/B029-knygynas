@model IEnumerable<Knygynas.Models.Bookstore>

@{
    ViewData["Title"] = "Bookstores";
}

<h1>Bookstores</h1>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="search" value="@(ViewData["Search"] as string ?? "")" class="form-control"
               placeholder="Search city or address" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<p>
    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="Bookstore" asp-action="Create" class="btn btn-primary">Create New</a>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.City)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.City)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedDate)
                </td>
                <td>
                    <a asp-controller="Bookstore" asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">Details</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Bookstore" asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">Edit</a>
                        <a asp-controller="Bookstore" asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
