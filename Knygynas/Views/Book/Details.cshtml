@model Knygynas.Models.Book

@{
    ViewBag.Title = "Book details";
    Layout = "_Layout";
}

@if (Model == null)
{
    <div class="alert alert-warning" role="alert">
        Book not found.
    </div>
}
else
{
    <div class="container storefront-page">
        <div class="row g-4 align-items-start">
            <div class="col-lg-4">
                <div class="card book-card h-100">
                    <div class="book-cover-media">
                        @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                        {
                            <img src="@Model.CoverImageUrl" alt="@Model.Title cover" class="book-cover-image" />
                        }
                        else
                        {
                            <div class="book-cover-fallback">
                                <span class="book-cover-fallback-kicker">Book details</span>
                                <span class="book-cover-fallback-title">@Model.Title</span>
                            </div>
                        }
                    </div>

                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <div class="storefront-kicker mb-1">Book spotlight</div>
                                <h2 class="h4 fw-bold mb-1">@Model.Title</h2>
                                <div class="book-meta">ISBN: @Model.ISBN</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <div class="text-muted small text-uppercase fw-semibold">Price</div>
                                <div class="book-price">$@Model.Price.ToString("F2")</div>
                            </div>
                            @if (Model.Available)
                            {
                                <span class="badge text-bg-success px-3 py-2">@Model.Quantity left</span>
                            }
                            else
                            {
                                <span class="badge text-bg-danger px-3 py-2">Out of stock</span>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge rounded-pill text-bg-light border text-dark">Released @Model.ReleaseDate.ToString("yyyy")</span>
                            @if (Model.Discount != null)
                            {
                                <span class="badge rounded-pill text-bg-warning text-dark">Discount #@Model.DiscountId</span>
                            }
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-action="List" class="btn btn-outline-secondary">Back to list</a>
                            @if (Model.Available)
                            {
                                <button class="btn btn-dark add-to-cart" data-isbn="@Model.ISBN">Add to Cart</button>
                            }
                            else
                            {
                                <button class="btn btn-secondary" disabled>Out of Stock</button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card storefront-panel mb-4">
                    <div class="card-body p-4 p-lg-5">
                        <h3 class="storefront-section-title h4 mb-3">Book information</h3>
                        <dl class="row mb-0">
                            <dt class="col-sm-4 col-md-3">Page count</dt>
                            <dd class="col-sm-8 col-md-9">@Model.PageCount</dd>

                            <dt class="col-sm-4 col-md-3">Language</dt>
                            <dd class="col-sm-8 col-md-9">@Model.Language</dd>

                            <dt class="col-sm-4 col-md-3">EAN code</dt>
                            <dd class="col-sm-8 col-md-9">@Model.EANCode</dd>

                            <dt class="col-sm-4 col-md-3">Dimensions</dt>
                            <dd class="col-sm-8 col-md-9">
                                @{
                                    var hasAnyDim = Model.Length.HasValue || Model.Width.HasValue || Model.Height.HasValue || Model.Weight.HasValue;
                                }

                                @if (!hasAnyDim)
                                {
                                    <span class="text-muted">-</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (Model.Length.HasValue)
                                        {
                                            <span class="chip">Length: @Model.Length</span>
                                        }
                                        @if (Model.Width.HasValue)
                                        {
                                            <span class="chip">Width: @Model.Width</span>
                                        }
                                        @if (Model.Height.HasValue)
                                        {
                                            <span class="chip">Height: @Model.Height</span>
                                        }
                                        @if (Model.Weight.HasValue)
                                        {
                                            <span class="chip">Weight: @Model.Weight</span>
                                        }
                                    </div>
                                }
                            </dd>

                            <dt class="col-sm-4 col-md-3">Authors</dt>
                            <dd class="col-sm-8 col-md-9">
                                @if (Model.AuthorRoles == null || !Model.AuthorRoles.Any())
                                {
                                    <span class="text-muted">-</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var a in Model.AuthorRoles.Select(b => b.Author).Distinct())
                                        {
                                            <span class="chip">@a.Name</span>
                                        }
                                    </div>
                                }
                            </dd>

                            <dt class="col-sm-4 col-md-3">Categories</dt>
                            <dd class="col-sm-8 col-md-9">
                                @if (Model.BookCategories == null || !Model.BookCategories.Any())
                                {
                                    <span class="text-muted">-</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var c in Model.BookCategories.Select(b => b.Category).Distinct())
                                        {
                                            <span class="chip chip-blue">@c.Name</span>
                                        }
                                    </div>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>
}